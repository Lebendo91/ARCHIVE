# Dependencies
node_modules/

# Frontend build output
dist/
# pdf.js resources copied from node_modules by vite.config.ts
/public/pdfjs/
*.tsbuildinfo

# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/schemas/

# Tests and reports
coverage/
playwright-report/
test-results/
blob-report/
visual-audit/

# Logs
*.log
npm-debug.log*

# Local environment and secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key

# Local development data (databases, imported files)
*.db
*.db-shm
*.db-wal
/.archive-dev-data/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Python bytecode (validation scripts)
__pycache__/
